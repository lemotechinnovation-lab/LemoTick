{
    "dashboard": {
        "id": null,
        "title": "LemoTick Alerts",
        "tags": [
            "lemotick",
            "alerts"
        ],
        "style": "dark",
        "timezone": "browser",
        "panels": [
            {
                "id": 1,
                "title": "Active Alerts",
                "type": "stat",
                "targets": [
                    {
                        "expr": "sum(ALERTS{alertname=~\"lemotick.*\", alertstate=\"firing\"})",
                        "refId": "A"
                    }
