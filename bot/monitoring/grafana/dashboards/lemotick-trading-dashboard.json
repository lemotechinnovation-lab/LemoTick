{
  "dashboard": {
    "id": null,
    "title": "LemoTick Trading Dashboard",
    "tags": ["lemotick", "trading"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Bot Status",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"lemotick-bot\"}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Account Type",
        "type": "stat",
        "targets": [
          {
            "expr": "lemotick_account_type",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "Demo"}}, "type": "value"},
              {"options": {"1": {"text": "Real"}}, "type": "value"}
            ]
          }
        }
      },
      {
        "id": 3,
        "title": "Total Trades",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(lemotick_trades_total)",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "Winning Trades",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(lemotick_trades_total{result=\"win\"})",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "fixed", "fixedColor": "green"}
          }
        }
      },
      {
        "id": 5,
        "title": "Losing Trades",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(lemotick_trades_total{result=\"loss\"})",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "fixed", "fixedColor": "red"}
          }
        }
      },
      {
        "id": 6,
        "title": "Win Rate",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(lemotick_trades_total{result=\"win\"}) / sum(lemotick_trades_total{result=~\"win|loss\"}) * 100",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 50},
                {"color": "green", "value": 70}
              ]
            }
          }
        }
      },
      {
        "id": 7,
        "title": "Trades Over Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(lemotick_trades_total[5m])",
            "refId": "A",
            "legendFormat": "{{result}} trades/min"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 8,
        "title": "Trade Results Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (result) (lemotick_trades_total{result=~\"win|loss\"})",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 9,
        "title": "Account Balance",
        "type": "stat",
        "targets": [
          {
            "expr": "lemotick_account_balance",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      },
      {
        "id": 10,
        "title": "Current Equity",
        "type": "stat",
        "targets": [
          {
            "expr": "lemotick_current_equity",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s",
    "schemaVersion": 27,
    "version": 1
  }
}
