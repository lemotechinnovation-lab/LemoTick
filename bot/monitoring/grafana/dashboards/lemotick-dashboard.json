      "id": 14,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "<div style='background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0a0a0a 100%); color: #00ff00; padding: 20px; border-radius: 15px; font-family: \"Courier New\", monospace; height: 100%; overflow-y: auto; border: 2px solid #00ff00; box-shadow: 0 0 30px rgba(0, 255, 0, 0.5), inset 0 0 20px rgba(0, 255, 0, 0.1); position: relative;'>\n<div style='position: absolute; top: 10px; right: 15px; color: #00ff00; font-size: 12px; animation: blink 1s infinite;'>💬 CHAT</div>\n<div style='color: #00ff00; font-weight: bold; font-size: 18px; margin-bottom: 20px; text-align: center; text-shadow: 0 0 15px #00ff00; animation: glow 2s ease-in-out infinite alternate;'>💬 Matrix Chat Integration</div>\n\n<div style='background: rgba(0, 255, 0, 0.1); padding: 15px; border-radius: 10px; border: 1px solid #00ff00; margin-bottom: 15px; box-shadow: 0 0 15px rgba(0, 255, 0, 0.2);'>\n  <div style='color: #00ff00; font-weight: bold; margin-bottom: 10px; font-size: 14px;'>🔗 Matrix Integration Status</div>\n  <div style='color: #ffffff; font-size: 12px; margin-bottom: 5px;'>Server: <span style='color: #00ff00; font-weight: bold;'>matrix.org</span></div>\n  <div style='color: #ffffff; font-size: 12px; margin-bottom: 5px;'>Room: <span style='color: #00ff00;'>#lemotick-trading</span></div>\n  <div style='color: #ffffff; font-size: 12px; margin-bottom: 5px;'>Status: <span style='color: #00ff00;'>CONNECTED</span></div>\n  <div style='color: #ffffff; font-size: 12px;'>Messages: <span style='color: #00ff00;'>Live</span></div>\n</div>\n\n<div style='background: rgba(255, 0, 255, 0.1); padding: 15px; border-radius: 10px; border: 1px solid #ff00ff; margin-bottom: 15px; box-shadow: 0 0 15px rgba(255, 0, 255, 0.2);'>\n  <div style='color: #ff00ff; font-weight: bold; margin-bottom: 10px; font-size: 14px;'>📱 Recent Messages</div>\n  <div style='color: #00ff00; font-size: 11px; margin-bottom: 3px; font-family: monospace;'>[19:32:22] <span style='color: #00ffff;'>@trader_bot:</span> Trade executed: BUY 888.82</div>\n  <div style='color: #00ff00; font-size: 11px; margin-bottom: 3px; font-family: monospace;'>[19:32:20] <span style='color: #ffff00;'>@alice:</span> Market looking bullish today</div>\n  <div style='color: #00ff00; font-size: 11px; margin-bottom: 3px; font-family: monospace;'>[19:32:18] <span style='color: #ff8800;'>@bob:</span> What's the current strategy?</div>\n  <div style='color: #888888; font-size: 11px; margin-bottom: 3px; font-family: monospace;'>[19:32:15] <span style='color: #00ff00;'>@system:</span> Bot status: ACTIVE</div>\n</div>\n\n<div style='background: rgba(0, 255, 255, 0.1); padding: 15px; border-radius: 10px; border: 1px solid #00ffff; box-shadow: 0 0 15px rgba(0, 255, 255, 0.2);'>\n  <div style='color: #00ffff; font-weight: bold; margin-bottom: 10px; font-size: 14px;'>⚡ Chat Commands</div>\n  <div style='color: #ffffff; font-size: 11px; margin-bottom: 2px;'>!status - Bot status</div>\n  <div style='color: #ffffff; font-size: 11px; margin-bottom: 2px;'>!trades - Active trades</div>\n  <div style='color: #ffffff; font-size: 11px; margin-bottom: 2px;'>!balance - Account balance</div>\n  <div style='color: #ffffff; font-size: 11px;'>!help - All commands</div>\n</div>\n\n<div style='display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding-top: 10px; border-top: 1px solid #333;'>\n  <div style='color: #888888; font-size: 11px;'>Last message: <span id='chat_timestamp' style='color: #00ff00; font-weight: bold;'></span></div>\n  <div style='color: #00ff00; font-size: 11px;'>💬 LIVE CHAT</div>\n</div>\n\n<style>\n@keyframes blink {\n  0%, 50% { opacity: 1; }\n  51%, 100% { opacity: 0.3; }\n}\n@keyframes glow {\n  from { text-shadow: 0 0 15px #00ff00; }\n  to { text-shadow: 0 0 25px #00ff00, 0 0 35px #00ff00; }\n}\n</style>\n\n<script>\ndocument.getElementById('chat_timestamp').textContent = new Date().toLocaleTimeString();\nsetInterval(() => {\n  document.getElementById('chat_timestamp').textContent = new Date().toLocaleTimeString();\n}, 1000);\n</script>\n</div>",
