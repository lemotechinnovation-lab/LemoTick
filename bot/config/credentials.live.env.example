# ================================================================================
# LemoTick LIVE Trading Credentials - EXAMPLE FILE
# ================================================================================
# ⚠️  Instructions:
# 1. Copy this file to: credentials.live.env
# 2. Replace YOUR_LIVE_TOKEN_HERE with your actual live Deriv API token
# 3. NEVER commit credentials.live.env to Git
# 4. Keep this file secure (treat like a password)
# ================================================================================

# ================================================================================
# LIVE DERIV API CREDENTIALS
# ================================================================================
# Get your live token from: https://app.deriv.com/account/api-token
# Required scopes: Read, Trade, Payments, Trading Information
# ================================================================================

DERIV_API_TOKEN=YOUR_LIVE_TOKEN_HERE
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_APP_ID=1089

# ================================================================================
# ACCOUNT MODE CONTROL
# ================================================================================
# This ensures the bot knows it's using a live account
# ================================================================================

LEMOTICK_LIVE_ACCOUNT=true
LEMOTICK_CONFIRM_LIVE=false  # Set to true to skip interactive confirmation (NOT RECOMMENDED)

# ================================================================================
# LOGGING CONFIGURATION
# ================================================================================
# Keep detailed logs for live trading (important for debugging)
# ================================================================================

LOG_LEVEL=INFO
DEBUG_MODE=false
SIMULATION_MODE=false
TEST_MODE=false

# ================================================================================
# SAFETY NOTES:
# ================================================================================
# - This token has REAL MONEY trading access
# - Protect it like a credit card number
# - Never share it with anyone
# - Regenerate immediately if compromised
# - Monitor your Deriv account regularly
# - Set up 2FA on your Deriv account
# - Review all trades in Deriv dashboard
# ================================================================================

# ================================================================================
# HOW TO USE THIS FILE:
# ================================================================================
# 1. Copy to credentials.live.env:
#    cp credentials.live.env.example credentials.live.env
#
# 2. Edit credentials.live.env:
#    Replace YOUR_LIVE_TOKEN_HERE with your actual token
#
# 3. Test the token:
#    python test_live_token.py
#
# 4. Start live trading:
#    START_LIVE_VERIFIED.bat
# ================================================================================

