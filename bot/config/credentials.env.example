# ================================================================================
# LemoTick Credentials Configuration - EXAMPLE FILE
# ================================================================================
# Instructions:
# 1. Copy this file to: credentials.demo.env (for demo trading)
#    OR to: credentials.live.env (for live trading)
# 2. Replace your_deriv_api_token_here with your actual token
# 3. Set LEMOTICK_LIVE_ACCOUNT appropriately (false for demo, true for live)
# ================================================================================

# ================================================================================
# DERIV API CREDENTIALS
# ================================================================================
# Get your token from: https://app.deriv.com/account/api-token
# - Demo tokens start with virtual account
# - Live tokens require real account verification
# ================================================================================

DERIV_API_TOKEN=your_deriv_api_token_here
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_APP_ID=1089

# ================================================================================
# ACCOUNT MODE CONTROL
# ================================================================================
# Set to false for demo trading (virtual money)
# Set to true for live trading (real money - requires confirmation)
# ================================================================================

LEMOTICK_LIVE_ACCOUNT=false
LEMOTICK_CONFIRM_LIVE=false  # Set to true to skip confirmation (NOT recommended)

# ================================================================================
# LOGGING CONFIGURATION
# ================================================================================

LOG_LEVEL=INFO
DEBUG_MODE=false
SIMULATION_MODE=false
TEST_MODE=false

# ================================================================================
# SECURITY NOTES:
# ================================================================================
# - Never commit credential files with actual tokens to Git
# - Keep demo and live credentials in separate files
# - Protect live tokens like passwords
# - Use demo account for testing
# ================================================================================

