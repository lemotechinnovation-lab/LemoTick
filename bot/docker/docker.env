# LemoTick Docker Environment Configuration

# PostgreSQL Database Configuration
POSTGRES_PASSWORD=lemotick_secure_password_123
POSTGRES_DB=InvestorManagementSystemDb
POSTGRES_USER=lemotick_user

# Deriv API Configuration (for the bot)
DERIV_API_TOKEN=your_deriv_api_token_here
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3
DERIV_APP_ID=1089

# Bot Configuration
LOG_LEVEL=INFO
DEBUG_MODE=false
SIMULATION_MODE=false

# Backend API Configuration
BACKEND_URL=http://localhost:5000
BACKEND_API_KEY=your_backend_api_key_here

# JWT Configuration
JWT_KEY=YourSuperSecretKeyThatIsAtLeast32CharactersLong!
JWT_ISSUER=InvestorManagementSystem
JWT_AUDIENCE=InvestorManagementSystemUsers
JWT_EXPIRATION_MINUTES=60

# Database Connection String (for the backend)
DATABASE_URL=Host=postgres;Port=5432;Database=InvestorManagementSystemDb;Username=lemotick_user;Password=lemotick_secure_password_123

# Monitoring Configuration
PROMETHEUS_RETENTION=200h
GRAFANA_ADMIN_PASSWORD=admin

# Redis Configuration (if using Redis)
REDIS_PASSWORD=your_redis_password_here
