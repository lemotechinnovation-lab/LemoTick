{
    "ConnectionStrings": {
        "DefaultConnection": "#{ConnectionStrings:DefaultConnection}#",
        "SqlServerConnection": "#{ConnectionStrings:SqlServerConnection}#",
        "PostgreSqlConnection": "#{ConnectionStrings:DefaultConnection}#"
    },
    "DatabaseProvider": "PostgreSQL",
    "Jwt": {
        "Key": "#{Jwt:Key}#",
        "Issuer": "#{Jwt:Issuer}#",
        "Audience": "#{Jwt:Audience}#",
        "ExpirationMinutes": 60
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": "Information",
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/investor-management-.txt",
                    "rollingInterval": "Day"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "AllowedOrigins": "#{AllowedOrigins}#",
    "Email": {
        "SmtpHost": "#{Email:SmtpHost}#",
        "SmtpPort": "#{Email:SmtpPort}#",
        "SmtpUser": "#{Email:SmtpUser}#",
        "SmtpPassword": "#{Email:SmtpPassword}#",
        "FromEmail": "#{Email:FromEmail}#",
        "FromName": "LemoTick",
        "EnableSsl": "true"
    },
    "FileStorage": {
        "LocalPath": "uploads",
        "BaseUrl": "/files",
        "MaxFileSizeMB": 10,
        "AllowedExtensions": [
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".doc",
            ".docx"
        ]
    },
    "PayFast": {
        "UseSandbox": true,
        "MerchantId": "#{PayFast:MerchantId}#",
        "MerchantKey": "#{PayFast:MerchantKey}#",
        "Passphrase": "#{PayFast:Passphrase}#",
        "SandboxUrl": "https://sandbox.payfast.co.za/eng/process",
        "ProductionUrl": "https://www.payfast.co.za/eng/process"
    },
    "IpRateLimiting": {
        "EnableEndpointRateLimiting": true,
        "StackBlockedRequests": false,
        "RealIpHeader": "X-Real-IP",
        "ClientIdHeader": "X-ClientId",
        "HttpStatusCode": 429,
        "GeneralRules": [
            {
                "Endpoint": "*",
                "Period": "1s",
                "Limit": 10
            },
            {
                "Endpoint": "*",
                "Period": "1m",
                "Limit": 100
            },
            {
                "Endpoint": "*",
                "Period": "1h",
                "Limit": 1000
            }
        ],
        "EndpointWhitelist": [
            "get:/api/health"
        ],
        "ClientWhitelist": []
    },
    "IpRateLimitPolicies": {
        "IpRules": [
            {
                "Ip": "127.0.0.1",
                "Rules": [
                    {
                        "Endpoint": "*",
                        "Period": "1s",
                        "Limit": 100
                    }
                ]
            }
        ]
    },
    "Bot": {
        "Directory": "../../bot",
        "PythonExecutable": "python"
    }
}