# ============================================================================
# LemoTick Autostart Bot - Configuration Template
# Copy this file to .env and fill in your values
# ============================================================================

# DERIV API CONFIGURATION
# ============================================================================
DERIV_API_TOKEN=tPGIvs6WyevJYVH
DERIV_APP_ID=107630
DERIV_WS_URL=wss://ws.derivws.com/websockets/v3

# TRADING CONFIGURATION
# ============================================================================
# Trading mode: 'demo' for testing, 'live' for real money
TRADING_MODE=demo

# Symbol to trade: R_50 (Volatility 50), R_100 (Volatility 100), etc.
SYMBOL=R_50

# Timeframe: 1m (1 minute), 5m (5 minutes), etc.
TIMEFRAME=1m

# Stake amount per trade in USD
STAKE_AMOUNT=2.0

# Contract duration in minutes
CONTRACT_DURATION=5

# Number of candles to wait for confirmation
SIGNAL_CONFIRMATION_CANDLES=1

# STRATEGY CONFIGURATION - Triple Indicator System
# ============================================================================
# EMA (Exponential Moving Average) - Trend Filter
EMA_FAST_PERIOD=4
EMA_SLOW_PERIOD=12

# RSI (Relative Strength Index) - Momentum Filter
RSI_PERIOD=6
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# MACD (Moving Average Convergence Divergence) - Entry Trigger
MACD_FAST_PERIOD=3
MACD_SLOW_PERIOD=6
MACD_SIGNAL_PERIOD=6
MACD_MIN_HISTOGRAM=0.01

# Bollinger Bands - Volatility Filter
BB_PERIOD=20
BB_DEVIATION=2.0

# RISK MANAGEMENT CONFIGURATION
# ============================================================================
# Take profit percentage (40% = 0.40)
TAKE_PROFIT_PCT=0.40

# Stop loss percentage (0 = disabled)
STOP_LOSS_PCT=0.0

# Maximum daily loss in USD
MAX_DAILY_LOSS=500.0

# Maximum concurrent trades
MAX_CONCURRENT_TRADES=1

# Risk per trade as percentage of account (0.18% = 0.0018)
RISK_PER_TRADE=0.0018

# HEDGING CONFIGURATION (Advanced - Use with caution)
# ============================================================================
# Enable hedging when losing
ENABLE_HEDGE=false

# Trigger hedging when loss reaches this level
HEDGE_TRIGGER_PIPS=-5

# Close both positions when combined profit reaches this level
HEDGE_CLOSE_PROFIT=2

# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# Log file path
LOG_FILE=logs/lemotickautostart.log

# MONITORING CONFIGURATION
# ============================================================================
# Enable Prometheus metrics
ENABLE_METRICS=true

# Prometheus port
PROMETHEUS_PORT=9092

# BACKEND INTEGRATION (Optional)
# ============================================================================
# Backend API URL
BACKEND_URL=https://api.lemotick.com

# Enable backend integration
BACKEND_ENABLED=false

# Portfolio ID for tracking
PORTFOLIO_ID=your_portfolio_id_here

# DATABASE CONFIGURATION (Optional)
# ============================================================================
# Database URL for trade history
DATABASE_URL=sqlite:///./lemotickautostart.db

# NOTIFICATION CONFIGURATION (Optional)
# ============================================================================
# Enable notifications
ENABLE_NOTIFICATIONS=false

# Telegram bot token (for notifications)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID (for notifications)
TELEGRAM_CHAT_ID=

# ADVANCED CONFIGURATION
# ============================================================================
# Enable multi-timeframe analysis
ENABLE_MULTI_TIMEFRAME=false

# Secondary timeframe for confirmation
SECONDARY_TIMEFRAME=5m

# Enable adaptive parameters
ENABLE_ADAPTIVE_PARAMS=false

# Minimum volatility to trade (in pips)
MIN_VOLATILITY=0.5

# Maximum volatility to trade (in pips)
MAX_VOLATILITY=100.0

# Trading hours (24-hour format, e.g., "09:00-17:00")
TRADING_HOURS=00:00-23:59

# Days to trade (comma-separated: MON,TUE,WED,THU,FRI,SAT,SUN)
TRADING_DAYS=MON,TUE,WED,THU,FRI,SAT,SUN
